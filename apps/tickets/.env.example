# tickets service — copy to `.env` before `pnpm -F tickets dev` (or `db:migrate`).
# `.env` is gitignored; this template is the committed source of truth.

# Connects as the per-service `tickets_user` role, scoped to the `tickets` schema.
DATABASE_URL=postgres://tickets_user:tickets_dev@localhost:5432/tix?search_path=tickets

AUTH_BASE_URL=http://localhost:4001
NATS_URL=nats://localhost:4222

# Shared HMAC token for tickets ↔ orders service calls. Must match orders/.env.
TICKETS_SERVICE_TOKEN=dev-tickets-service-token

# Optional — defaults shown.
# TICKETS_HTTP_PORT=4002
# LOG_LEVEL=info
