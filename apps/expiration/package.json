{
  "name": "expiration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo --noEmit",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nats-io/transport-node": "catalog:",
    "@tix/contracts": "workspace:*",
    "@tix/db-core": "workspace:*",
    "@tix/messaging": "workspace:*",
    "@tix/observability": "workspace:*",
    "arktype": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "pino": "catalog:",
    "postgres": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@nats-io/jetstream": "catalog:",
    "@tix/config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
