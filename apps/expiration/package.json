{
  "name": "expiration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo --noEmit",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@nats-io/transport-node": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@tix/contracts": "workspace:*",
    "@tix/db-core": "workspace:*",
    "@tix/messaging": "workspace:*",
    "@tix/observability": "workspace:*",
    "@tix/service-runtime": "workspace:*",
    "arktype": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@nats-io/jetstream": "catalog:",
    "@tix/config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
