# expiration worker — copy to `.env` before `pnpm -F expiration dev` (or `db:migrate`).
# Headless BullMQ worker: no HTTP port. `.env` is gitignored; this is the template.

# Connects as the per-service `expiration_user` role, scoped to the `expiration` schema.
DATABASE_URL=postgres://expiration_user:expiration_dev@localhost:5432/tix?search_path=expiration

NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379

# Optional — defaults shown.
# LOG_LEVEL=info
