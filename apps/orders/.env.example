# orders service — copy to `.env` before `pnpm -F orders dev` (or `db:migrate`).
# `.env` is gitignored; this template is the committed source of truth.

# Connects as the per-service `orders_user` role, scoped to the `orders` schema.
DATABASE_URL=postgres://orders_user:orders_dev@localhost:5432/tix?search_path=orders

AUTH_BASE_URL=http://localhost:4001
TICKETS_BASE_URL=http://localhost:4002
NATS_URL=nats://localhost:4222

# Shared HMAC token for tickets ↔ orders service calls. Must match tickets/.env.
TICKETS_SERVICE_TOKEN=dev-tickets-service-token

# Optional — defaults shown.
# ORDERS_HTTP_PORT=4003
# RESERVATION_TTL_MS=120000
# LOG_LEVEL=info
