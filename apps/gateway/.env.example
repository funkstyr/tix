# gateway (edge ingress) — copy to `.env` before `pnpm -F gateway dev`.
# Owns no schema, so no DATABASE_URL. `.env` is gitignored; this is the template.

# CORS origin the gateway accepts — the Vite dev server's URL (see apps/web).
WEB_ORIGIN=http://localhost:5173

# Downstream service URLs. In dev these are the host ports `pnpm dev` binds;
# in k8s, infra/pulumi/index.ts injects `http://<name>:<port>` instead.
AUTH_BASE_URL=http://localhost:4001
TICKETS_BASE_URL=http://localhost:4002
ORDERS_BASE_URL=http://localhost:4003
PAYMENTS_BASE_URL=http://localhost:4004

# Optional — defaults shown.
# GATEWAY_HTTP_PORT=4000
# SESSION_COOKIE_NAME=tix.session
# LOG_LEVEL=info
