# tix web app — copy to `.env` (or `.env.local`) before running `pnpm -F web dev`.
# Vite exposes only `VITE_*` vars to client code. Both are validated at startup
# by `src/env.ts` and missing/invalid values fail loudly.

VITE_GATEWAY_URL=http://localhost:4000
VITE_STRIPE_PK=pk_test_replace_me

# Frontend RUM (ADR-0013). Unset → RUM disabled. Point at the gateway's RUM proxy route.
VITE_RUM_URL=http://localhost:4000/otel/v1/faro
VITE_RUM_APP_NAME=tix-web
VITE_RUM_SAMPLE_RATE=1
