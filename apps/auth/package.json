{
  "name": "auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/auth-app.ts",
    "./instance": "./src/auth-instance.ts",
    "./migrations": "./src/migrations.ts",
    "./router": "./src/router.ts",
    "./schema": "./src/auth-schema.ts",
    "./test-runtime": "./src/auth-test-runtime.ts"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo --noEmit",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start": "node dist/index.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@hono/node-server": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@orpc/server": "catalog:",
    "@tix/contracts": "workspace:*",
    "@tix/db-core": "workspace:*",
    "@tix/messaging": "workspace:*",
    "@tix/observability": "workspace:*",
    "arktype": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "hono": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@tix/config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
