# auth service — copy to `.env` before `pnpm -F auth dev` (or `pnpm -F auth db:migrate`).
# `pnpm dev` picks this up via `--env-file-if-exists=.env`; values are validated
# at startup by `src/index.ts` and missing/invalid ones fail loudly.
# `.env` is gitignored; this template is the committed source of truth.

# Connects as the per-service `auth_user` role, scoped to the `auth` schema.
DATABASE_URL=postgres://auth_user:auth_dev@localhost:5432/tix?search_path=auth

# better-auth signing secret. Any non-empty value works locally; keep it ≥ 32 chars.
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-min-32-chars

# Optional — defaults shown.
# AUTH_HTTP_PORT=4001
# AUTH_BASE_URL=http://localhost:4001
# LOG_LEVEL=info
