# payments service — copy to `.env` before `pnpm -F payments dev` (or `db:migrate`).
# `.env` is gitignored; this template is the committed source of truth.

# Connects as the per-service `payments_user` role, scoped to the `payments` schema.
DATABASE_URL=postgres://payments_user:payments_dev@localhost:5432/tix?search_path=payments

AUTH_BASE_URL=http://localhost:4001
NATS_URL=nats://localhost:4222

# Stripe test-mode secret key. The placeholder boots the service; real charges
# (and the web-e2e Playwright flow) need a genuine `sk_test_…` key.
STRIPE_KEY=sk_test_replace_me

# Optional — defaults shown.
# PAYMENTS_HTTP_PORT=4004
# LOG_LEVEL=info
