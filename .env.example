# tix local infrastructure — copy to `.env` and edit if you need non-default secrets.
# `.env` is gitignored; this template is the source of truth for the variable surface.

# --- Postgres (single cluster, per-service schemas, per-service roles) ---

POSTGRES_PASSWORD=postgres

AUTH_PASSWORD=auth_dev
TICKETS_PASSWORD=tickets_dev
ORDERS_PASSWORD=orders_dev
PAYMENTS_PASSWORD=payments_dev
EXPIRATION_PASSWORD=expiration_dev

AUTH_DATABASE_URL=postgres://auth_user:auth_dev@localhost:5432/tix?search_path=auth
TICKETS_DATABASE_URL=postgres://tickets_user:tickets_dev@localhost:5432/tix?search_path=tickets
ORDERS_DATABASE_URL=postgres://orders_user:orders_dev@localhost:5432/tix?search_path=orders
PAYMENTS_DATABASE_URL=postgres://payments_user:payments_dev@localhost:5432/tix?search_path=payments
EXPIRATION_DATABASE_URL=postgres://expiration_user:expiration_dev@localhost:5432/tix?search_path=expiration

# --- NATS JetStream ---

NATS_URL=nats://localhost:4222

# --- Redis (BullMQ broker) ---

REDIS_URL=redis://localhost:6379
