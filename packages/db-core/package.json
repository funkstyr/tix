{
  "name": "@tix/db-core",
  "version": "0.0.0",
  "private": true,
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo --build",
    "dev": "tsdown --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@tix/config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
